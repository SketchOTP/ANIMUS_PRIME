[Unit]
Description=ANIMUS PRIME persistent Core and Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sketch/Projects/ANIMUS_PRIME
ExecStartPre=/usr/bin/docker inspect --type=container animus-prime-core
ExecStart=/usr/bin/docker start --attach animus-prime-core
ExecStop=/usr/bin/docker stop --time=30 animus-prime-core
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=60
KillMode=process

[Install]
WantedBy=default.target
