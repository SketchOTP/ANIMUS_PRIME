FROM python:3.13.7-slim@sha256:2be5d3cb08aa616c6e38d922bd7072975166b2de772004f79ee1bae59fe983dc

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY requirements-phase1.txt .
RUN pip install --no-cache-dir -r requirements-phase1.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY apps ./apps
COPY src ./src
COPY migrations ./migrations

USER nobody
EXPOSE 8000
CMD ["uvicorn", "apps.core.main:app", "--host", "127.0.0.1", "--port", "8000"]
