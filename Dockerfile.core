FROM python:3.13.7-slim@sha256:2be5d3cb08aa616c6e38d922bd7072975166b2de772004f79ee1bae59fe983dc

ARG PRIME_BUILD_COMMIT=UNKNOWN
ARG PRIME_BUILD_TIMESTAMP=UNKNOWN
ARG PRIME_IMAGE_IDENTITY=animus-prime-core:unidentified
ARG PRIME_SERVICE_VERSION=1.0.0
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
ENV PRIME_BUILD_COMMIT=${PRIME_BUILD_COMMIT} \
    PRIME_BUILD_TIMESTAMP=${PRIME_BUILD_TIMESTAMP} \
    PRIME_IMAGE_IDENTITY=${PRIME_IMAGE_IDENTITY} \
    PRIME_SERVICE_VERSION=${PRIME_SERVICE_VERSION}
LABEL org.opencontainers.image.revision=${PRIME_BUILD_COMMIT} \
      org.opencontainers.image.created=${PRIME_BUILD_TIMESTAMP} \
      org.opencontainers.image.title=${PRIME_IMAGE_IDENTITY}
WORKDIR /app
COPY requirements-phase1.txt .
RUN pip install --no-cache-dir -r requirements-phase1.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY apps ./apps
COPY src ./src
COPY migrations ./migrations
COPY authority-template ./authority-template
# Preserve the non-root runtime contract when source files carry owner-only modes.
RUN chmod -R a+rX /app

USER nobody
EXPOSE 8000
CMD ["uvicorn", "apps.core.main:app", "--host", "127.0.0.1", "--port", "8000"]
